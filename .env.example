# Copy to .env.local (local) or set in your hosting dashboard (Vercel / Cloudflare).
# This app needs NO API keys and NO secrets: all logic runs in the browser.

# Which institution configuration to use (a file in config/institutions/).
# Values included: uniminuto (default), generic
NEXT_PUBLIC_INSTITUTION=generic

# Optional: set to 1 to produce a static site in ./out (used by `npm run build:static`).
# STATIC_EXPORT=1
